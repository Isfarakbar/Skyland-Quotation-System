{
  "name": "skyland-quotation-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "fixture": "node tests/fixtures/dev-server.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "test:ui": "vitest run",
    "migrate:dry": "node scripts/migrate-production.js",
    "migrate:apply": "node scripts/migrate-production.js --apply",
    "check": "npm run build && npm test && npm run test:ui && node --check server/index.js && node --check server/routes/auth.js && node --check server/routes/users.js && node --check server/routes/uploads.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^0.468.0",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.4",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.6"
  }
}
