# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skyland?retryWrites=true&w=majority

# Brevo (Sendinblue) Transactional Email API Key
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME=Skyland Energy
EMAIL_FROM_ADDRESS=info@theskylandenergy.com

# Public production URL (no trailing slash)
APP_URL=https://your-project.vercel.app

# Authentication (generate a random value of at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret

# One-time initial super admin bootstrap. Remove the password after first deployment.
SUPER_ADMIN_EMAIL=admin@skylandenergy.pk
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password
SUPER_ADMIN_FIRST_NAME=Skyland
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_PHONE=03000000000
SUPER_ADMIN_CNIC=00000-0000000-0

# Cloudinary signed uploads require all three values.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_numeric_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backend Server Port
PORT=5000
